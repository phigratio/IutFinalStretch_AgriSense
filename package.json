{
  "name": "iut-ict-fest-backend",
  "version": "1.0.0",
  "description": "TypeScript Express backend",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "prisma generate && tsc && npm run copy:assets",
    "copy:assets": "mkdir -p dist/data && cp src/data/*.csv src/data/*.json dist/data/",
    "start": "node dist/server.js",
    "test": "prisma generate && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed:tenants": "tsx scripts/seed-tenants.ts",
    "kb:import:dam": "tsx scripts/kb-import-dam.ts",
    "kb:audit": "tsx scripts/kb-audit.ts",
    "kb:audit:strict": "tsx scripts/kb-audit.ts --strict",
    "lint": "eslint . --ext .ts",
    "bdapps": "tsx src/bdapps/cli.ts"
  },
  "dependencies": {
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "express": "^5.1.0",
    "prisma": "^7.9.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.1.1",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
