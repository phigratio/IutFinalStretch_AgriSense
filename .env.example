# Copy to .env and fill in. NEVER commit the real .env (see docs/RULES.md 1.4).

# --- server ---
PORT=3000
NODE_ENV=development

# --- database (docker compose postgres w/ pgvector) ---
DATABASE_URL=postgresql://iut_ict_fest:iut_ict_fest@localhost:5432/iut_ict_fest

# --- auth ---
AUTH_TOKEN_SECRET=dev-only-change-this-auth-secret

# --- OpenAI (agent LLM + mem0 embedder; see docs/MEMORY.md D3/D5) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o

# --- mem0 (self-hosted, docker: mem0-api) ---
MEM0_API_URL=http://localhost:8888
MEM0_API_KEY=
RAG_EMBEDDING_DIMENSIONS=1536

# --- bdapps (from user.bdapps.com provisioning; see BDApps-Service-Setup.md) ---
BDAPPS_APP_ID=
BDAPPS_PASSWORD=
BDAPPS_APP_NAME=AgriSense
# BDAPPS_BASE_URL=https://developer.bdapps.com

# 1 = offline mock bdapps client (dev only — demo uses the real sandbox).
MOCK_BDAPPS=
# Starting per-number balance for the mock, in BDT.
MOCK_BDAPPS_BALANCE=100
