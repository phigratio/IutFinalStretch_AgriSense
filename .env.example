# Copy to .env and fill in. NEVER commit the real .env (see docs/RULES.md 1.4).

# --- server ---
PORT=3000
NODE_ENV=development
APP_PORT=3000
FRONTEND_PORT=5173
GRAFANA_PORT=3001

# --- database (docker compose postgres w/ pgvector) ---
POSTGRES_DB=iut_ict_fest
POSTGRES_USER=iut_ict_fest
POSTGRES_PASSWORD=iut_ict_fest
DATABASE_URL=postgresql://iut_ict_fest:iut_ict_fest@localhost:5432/iut_ict_fest

# --- auth ---
AUTH_TOKEN_SECRET=dev-only-change-this-auth-secret
AUTH_TOKEN_TTL_SECONDS=3600
COOKIE_SECURE=false
FRONTEND_AUTH_SUCCESS_URL=http://localhost:5173/
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# --- OpenAI (agent LLM + mem0 embedder; see docs/MEMORY.md D3/D5) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_INTAKE_MODEL=gpt-4.1-mini

# --- mem0 (self-hosted, docker: mem0-api) ---
MEM0_API_PORT=8889
OTEL_PROM_EXPORTER_PORT=8890
MEM0_API_URL=http://localhost:8889
MEM0_API_KEY=dev-only-mem0-admin-key
MEM0_PERSISTENCE_ENABLED=true
MEM0_AUTH_DISABLED=true
MEM0_JWT_SECRET=dev-only-change-this-mem0-jwt-secret
MEM0_NEO4J_PASSWORD=mem0-password
MEM0_DEFAULT_LLM_MODEL=gpt-4o-mini
MEM0_DEFAULT_EMBEDDER_MODEL=text-embedding-3-small
MEM0_EMBEDDER_PROVIDER=openai
MEM0_EMBEDDING_DIMS=1536
RAG_EMBEDDING_DIMENSIONS=1536

# --- bdapps (from user.bdapps.com provisioning; see BDApps-Service-Setup.md) ---
BDAPPS_APP_ID=
BDAPPS_PASSWORD=
BDAPPS_APP_NAME=AgriSense
# BDAPPS_BASE_URL=https://developer.bdapps.com

# 1 = offline mock bdapps client (dev only — demo uses the real sandbox).
MOCK_BDAPPS=
# Starting per-number balance for the mock, in BDT.
MOCK_BDAPPS_BALANCE=100
