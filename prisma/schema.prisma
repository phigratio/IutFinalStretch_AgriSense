generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AppUser {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  name          String
  passwordHash  String?        @map("password_hash")
  emailVerified Boolean        @default(false) @map("email_verified")
  role          String         @default("user") // user | tenant | admin
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  identities    AuthIdentity[]
  ragMemories   RagMemory[]
  ragDocuments  RagDocument[]
  farmers       FarmerProfile[]
  agentSessions AgentSession[]
  payments      BdappsPayment[]
  memoryOutcomes AgentMemoryOutcome[]

  @@map("app_users")
}

model AuthIdentity {
  provider       String
  providerUserId String   @map("provider_user_id")
  userId         String   @map("user_id") @db.Uuid
  user           AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

model RagMemory {
  id        String                  @id @default(uuid()) @db.Uuid
  userId    String?                 @map("user_id") @db.Uuid
  user      AppUser?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId   String?                 @map("agent_id")
  runId     String?                 @map("run_id")
  role      String                  @default("memory")
  content   String
  metadata  Json                    @default("{}")
  tags      String[]                @default([])
  embedding Unsupported("vector(1536)")
  createdAt DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([agentId])
  @@index([runId])
  @@map("rag_memories")
}

model RagDocument {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String?            @map("user_id") @db.Uuid
  user      AppUser?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType String            @default("extension_manual") @map("source_type")
  source    String
  title     String?
  citationUrl String?          @map("citation_url")
  crop      String?
  region    String?
  language  String            @default("en")
  metadata  Json               @default("{}")
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  chunks    RagDocumentChunk[]

  @@index([userId])
  @@index([source])
  @@map("rag_documents")
}

model RagDocumentChunk {
  id         String                  @id @default(uuid()) @db.Uuid
  documentId String                  @map("document_id") @db.Uuid
  document   RagDocument             @relation(fields: [documentId], references: [id], onDelete: Cascade)
  ordinal    Int
  content    String
  section    String?
  crop       String?
  season     String?
  soilType   String?                 @map("soil_type")
  tokenCount Int?                    @map("token_count")
  metadata   Json                    @default("{}")
  embedding  Unsupported("vector(1536)")
  createdAt  DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([documentId, ordinal])
  @@index([documentId])
  @@map("rag_document_chunks")
}

model FarmerProfile {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String?       @map("user_id") @db.Uuid
  user           AppUser?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  bdappsMobile   String?       @map("bdapps_mobile")
  preferredName  String?       @map("preferred_name")
  preferredLanguage String     @default("en") @map("preferred_language")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  farms          FarmProfile[]
  sessions       AgentSession[]
  memoryOutcomes AgentMemoryOutcome[]

  @@index([userId])
  @@index([bdappsMobile])
  @@map("farmer_profiles")
}

model FarmProfile {
  id                String            @id @default(uuid()) @db.Uuid
  farmerId          String            @map("farmer_id") @db.Uuid
  farmer            FarmerProfile     @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  name              String?
  locationText      String?           @map("location_text")
  latitude          Decimal?          @db.Decimal(9, 6)
  longitude         Decimal?          @db.Decimal(9, 6)
  sizeAcres         Decimal?          @map("size_acres") @db.Decimal(10, 2)
  areaHa            Decimal?          @map("area_ha") @db.Decimal(10, 4)
  soilType          String?           @map("soil_type")
  soilTexture       String?           @map("soil_texture")
  fertilityClass    String?           @map("fertility_class")
  fertilitySource   String?           @map("fertility_source")
  district          String?
  upazila           String?
  waterAvailability String?           @map("water_availability")
  budgetBdt         Decimal?          @map("budget_bdt") @db.Decimal(12, 2)
  targetSeason      String?           @map("target_season")
  currentCrop       String?           @map("current_crop")
  metadata          Json              @default("{}")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions          AgentSession[]
  weatherSnapshots  WeatherSnapshot[]
  plans             SeasonPlan[]
  orders            MarketplaceOrder[]
  memoryOutcomes    AgentMemoryOutcome[]

  @@index([farmerId])
  @@index([locationText])
  @@map("farm_profiles")
}

model MarketplaceSupplier {
  id           String                    @id @default(uuid()) @db.Uuid
  name         String
  district     String
  latitude     Decimal?                  @db.Decimal(9, 6)
  longitude    Decimal?                  @db.Decimal(9, 6)
  rating       Decimal                   @default(0) @db.Decimal(3, 2)
  deliveryDays Int                       @default(3) @map("delivery_days")
  seeded       Boolean                   @default(true)
  createdAt    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  items        MarketplaceSupplierItem[]
  orders       MarketplaceOrder[]

  @@unique([name, district])
  @@index([district])
  @@index([rating])
  @@map("marketplace_suppliers")
}

model MarketplaceSupplierItem {
  id            String              @id @default(uuid()) @db.Uuid
  supplierId    String              @map("supplier_id") @db.Uuid
  supplier      MarketplaceSupplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  itemName      String              @map("item_name")
  category      String
  unit          String
  priceBdt      Decimal             @map("price_bdt") @db.Decimal(12, 2)
  stockQuantity Decimal             @map("stock_quantity") @db.Decimal(12, 2)
  seeded        Boolean             @default(true)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  orders        MarketplaceOrder[]

  @@unique([supplierId, itemName, unit])
  @@index([itemName])
  @@index([category])
  @@index([priceBdt])
  @@map("marketplace_supplier_items")
}

model MarketPrice {
  id                String   @id @default(uuid()) @db.Uuid
  crop              String
  marketName        String   @map("market_name")
  district          String
  unit              String
  observedAt        DateTime @map("observed_at") @db.Date
  wholesalePriceBdt Decimal  @map("wholesale_price_bdt") @db.Decimal(12, 2)
  farmgatePriceBdt  Decimal  @map("farmgate_price_bdt") @db.Decimal(12, 2)
  seeded            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([crop, marketName, observedAt])
  @@index([crop])
  @@index([district])
  @@index([observedAt])
  @@map("market_prices")
}

model MarketplaceOrder {
  id             String                  @id @default(uuid()) @db.Uuid
  farmId         String?                 @map("farm_id") @db.Uuid
  farm           FarmProfile?            @relation(fields: [farmId], references: [id], onDelete: SetNull)
  supplierId     String                  @map("supplier_id") @db.Uuid
  supplier       MarketplaceSupplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierItemId String                  @map("supplier_item_id") @db.Uuid
  supplierItem   MarketplaceSupplierItem @relation(fields: [supplierItemId], references: [id], onDelete: Restrict)
  quantity       Decimal                 @db.Decimal(12, 2)
  unit           String
  unitPriceBdt   Decimal                 @map("unit_price_bdt") @db.Decimal(12, 2)
  totalPriceBdt  Decimal                 @map("total_price_bdt") @db.Decimal(12, 2)
  status         String                  @default("quoted")
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([farmId])
  @@index([supplierId])
  @@index([status])
  @@map("marketplace_orders")
}

model AgentSession {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String?         @map("user_id") @db.Uuid
  user           AppUser?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  farmerId       String?         @map("farmer_id") @db.Uuid
  farmer         FarmerProfile?  @relation(fields: [farmerId], references: [id], onDelete: SetNull)
  farmId         String?         @map("farm_id") @db.Uuid
  farm           FarmProfile?    @relation(fields: [farmId], references: [id], onDelete: SetNull)
  channel        String          @default("web")
  status         String          @default("intake")
  missingFields  String[]        @default([]) @map("missing_fields")
  selectedCrop   String?         @map("selected_crop")
  metadata       Json            @default("{}")
  goal           String?
  summary        String?
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  toolCalls      AgentToolCall[]
  weather        WeatherSnapshot[]
  plans          SeasonPlan[]
  memoryOutcomes AgentMemoryOutcome[]

  @@index([userId])
  @@index([farmerId])
  @@index([farmId])
  @@index([status])
  @@map("agent_sessions")
}

model AgentToolCall {
  id            String       @id @default(uuid()) @db.Uuid
  sessionId     String       @map("session_id") @db.Uuid
  session       AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  toolName      String       @map("tool_name")
  purpose       String?
  parameters    Json         @default("{}")
  rawResponse   Json?        @map("raw_response")
  status        String       @default("success")
  errorMessage  String?      @map("error_message")
  startedAt     DateTime     @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt    DateTime?    @map("finished_at") @db.Timestamptz(6)

  @@index([sessionId])
  @@index([toolName])
  @@map("agent_tool_calls")
}

model WeatherSnapshot {
  id            String        @id @default(uuid()) @db.Uuid
  sessionId     String?       @map("session_id") @db.Uuid
  session       AgentSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  farmId        String?       @map("farm_id") @db.Uuid
  farm          FarmProfile?  @relation(fields: [farmId], references: [id], onDelete: SetNull)
  provider      String
  locationText  String        @map("location_text")
  forecastDate  DateTime      @map("forecast_date") @db.Date
  rainfallMm    Decimal?      @map("rainfall_mm") @db.Decimal(8, 2)
  temperatureMinC Decimal?    @map("temperature_min_c") @db.Decimal(5, 2)
  temperatureMaxC Decimal?    @map("temperature_max_c") @db.Decimal(5, 2)
  humidityPct   Decimal?      @map("humidity_pct") @db.Decimal(5, 2)
  snapshotType  String        @default("forecast") @map("snapshot_type")
  rawResponse   Json          @map("raw_response")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([sessionId])
  @@index([farmId])
  @@index([forecastDate])
  @@map("weather_snapshots")
}

model SeasonPlan {
  id                String           @id @default(uuid()) @db.Uuid
  sessionId         String?          @map("session_id") @db.Uuid
  session           AgentSession?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  farmId            String           @map("farm_id") @db.Uuid
  farm              FarmProfile      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  crop              String
  rank              Int?
  suitabilityScore  Decimal?         @map("suitability_score") @db.Decimal(5, 2)
  waterNeed         String           @map("water_need")
  riskLevel         String           @map("risk_level")
  reasoning         String
  retrievedChunkIds String[]         @default([]) @map("retrieved_chunk_ids")
  weatherSnapshotIds String[]        @default([]) @map("weather_snapshot_ids")
  expectedYieldUnit String           @default("kg") @map("expected_yield_unit")
  expectedYield     Decimal          @map("expected_yield") @db.Decimal(12, 2)
  expectedRevenueBdt Decimal         @map("expected_revenue_bdt") @db.Decimal(12, 2)
  totalCostBdt      Decimal          @map("total_cost_bdt") @db.Decimal(12, 2)
  netProfitBdt      Decimal          @map("net_profit_bdt") @db.Decimal(12, 2)
  roiPct            Decimal          @map("roi_pct") @db.Decimal(8, 2)
  breakEvenYield    Decimal          @map("break_even_yield") @db.Decimal(12, 2)
  breakEvenPriceBdtPerKg Decimal?    @map("break_even_price_bdt_per_kg") @db.Decimal(12, 2)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  items             SeasonPlanItem[]
  payments          BdappsPayment[]
  memoryOutcomes    AgentMemoryOutcome[]

  @@index([sessionId])
  @@index([farmId])
  @@index([crop])
  @@map("season_plans")
}

model SeasonPlanItem {
  id          String     @id @default(uuid()) @db.Uuid
  planId      String     @map("plan_id") @db.Uuid
  plan        SeasonPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  itemType    String     @map("item_type")
  title       String
  description String
  startDate   DateTime?  @map("start_date") @db.Date
  endDate     DateTime?  @map("end_date") @db.Date
  quantity    Decimal?   @db.Decimal(12, 2)
  unit        String?
  unitCostBdt Decimal?   @map("unit_cost_bdt") @db.Decimal(12, 2)
  totalCostBdt Decimal?  @map("total_cost_bdt") @db.Decimal(12, 2)
  reasoning   String?
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([planId])
  @@index([itemType])
  @@map("season_plan_items")
}

model ProactiveAlert {
  id             String    @id @default(uuid()) @db.Uuid
  farmId         String?   @map("farm_id") @db.Uuid
  sessionId      String?   @map("session_id") @db.Uuid
  planId         String?   @map("plan_id") @db.Uuid
  alertType      String    @map("alert_type")
  severity       String    @default("info")
  title          String
  message        String
  recommendation String
  ruleId         String    @map("rule_id")
  triggerDate    DateTime? @map("trigger_date") @db.Date
  rawEvidence    Json      @default("{}") @map("raw_evidence")
  fingerprint    String    @unique
  status         String    @default("open")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([farmId])
  @@index([sessionId])
  @@index([alertType])
  @@index([status])
  @@map("proactive_alerts")
}

model TemporalJobRun {
  id           String    @id @default(uuid()) @db.Uuid
  workflowType String    @map("workflow_type")
  workflowId   String?   @map("workflow_id")
  status       String
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(6)
  summary      Json      @default("{}")
  errorMessage String?   @map("error_message")

  @@index([workflowType])
  @@index([startedAt])
  @@map("temporal_job_runs")
}

model BdappsPayment {
  id                String      @id @default(uuid()) @db.Uuid
  userId            String?     @map("user_id") @db.Uuid
  user              AppUser?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  planId            String?     @map("plan_id") @db.Uuid
  plan              SeasonPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  mobile            String
  amountBdt         Decimal     @map("amount_bdt") @db.Decimal(12, 2)
  status            String      @default("pending")
  externalReference String?     @map("external_reference")
  requestPayload    Json        @default("{}") @map("request_payload")
  responsePayload   Json?       @map("response_payload")
  receiptNumber     String?     @map("receipt_number")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([planId])
  @@index([mobile])
  @@index([status])
  @@map("bdapps_payments")
}

model AgentMemoryOutcome {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String?        @map("user_id") @db.Uuid
  user           AppUser?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  farmerId       String?        @map("farmer_id") @db.Uuid
  farmer         FarmerProfile? @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  farmId         String?        @map("farm_id") @db.Uuid
  farm           FarmProfile?   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  sessionId      String?        @map("session_id") @db.Uuid
  session        AgentSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  planId         String?        @map("plan_id") @db.Uuid
  plan           SeasonPlan?    @relation(fields: [planId], references: [id], onDelete: SetNull)
  kind           String
  title          String
  summary        String
  valueJson      Json           @default("{}") @map("value_json")
  score          Decimal        @default(0) @db.Decimal(8, 2)
  sourceTraceIds String[]       @default([]) @map("source_trace_ids")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([farmerId])
  @@index([farmId])
  @@index([sessionId])
  @@index([planId])
  @@index([kind])
  @@index([score])
  @@map("agent_memory_outcomes")
}

model FarmFinanceEntry {
  id           String    @id @default(uuid()) @db.Uuid
  farmId       String?   @map("farm_id") @db.Uuid
  seasonPlanId String?   @map("season_plan_id") @db.Uuid
  entryType    String    @map("entry_type")
  category     String
  label        String
  amountBdt    Decimal   @map("amount_bdt") @db.Decimal(12, 2)
  entryDate    DateTime  @map("entry_date") @db.Date
  season       String?
  crop         String?
  source       String    @default("manual")
  metadata     Json      @default("{}")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([farmId])
  @@index([seasonPlanId])
  @@index([entryDate])
  @@index([season])
  @@index([source])
  @@map("farm_finance_entries")
}

// ---- Multi-tenant knowledge base (navid/kb) --------------------------------

model Tenant {
  id            String               @id @default(uuid()) @db.Uuid
  slug          String               @unique
  name          String
  kind          String               @default("district") // district | ngo | coop | hub
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  jurisdictions TenantJurisdiction[]
  members       TenantMember[]

  @@map("tenants")
}

model TenantJurisdiction {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  district String
  upazila  String?

  @@unique([tenantId, district, upazila])
  @@index([district])
  @@map("tenant_jurisdictions")
}

model TenantMember {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String @map("user_id") @db.Uuid
  role     String // hub_admin | tenant_admin

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_members")
}

model PriceObservation {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") // "hub" sentinel or a tenant id
  cropId         String   @map("crop_id")
  commodityLabel String?  @map("commodity_label")
  district       String?
  market         String?
  latitude       Decimal? @db.Decimal(9, 6)
  longitude      Decimal? @db.Decimal(9, 6)
  price          Decimal  @db.Decimal(12, 4)
  unit           String
  priceType      String   @map("price_type") // retail | wholesale
  currency       String   @default("BDT")
  observedAt     DateTime @map("observed_at") @db.Date
  source         String
  sourceUrl      String?  @map("source_url")
  dataOrigin     String   @map("data_origin") // real | manual | mock
  verification   String   @default("unverified")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([cropId, district, observedAt])
  @@index([tenantId])
  @@map("price_observations")
}

model KbTableOverride {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id")
  kind       String // fertilizer | calendar | water | variety | srdi
  cropId     String   @map("crop_id")
  district   String?
  payload    Json
  source     String
  dataOrigin String   @map("data_origin")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([kind, cropId, district])
  @@index([tenantId])
  @@map("kb_table_overrides")
}

model KbDocument {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id")
  scope      String // hub | tenant
  docKey     String   @map("doc_key")
  title      String
  source     String
  sourceUrl  String?  @map("source_url")
  page       String?
  cropId     String?  @map("crop_id")
  mem0Ids    String[] @default([]) @map("mem0_ids")
  dataOrigin String   @map("data_origin")
  verificationStatus String @default("unverified") @map("verification_status")
  retrievedAt DateTime? @map("retrieved_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, docKey])
  @@index([scope])
  @@map("kb_documents")
}

model KbIngestionJob {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id")
  requestedBy        String   @map("requested_by")
  status             String   @default("queued") // queued | processing | completed | failed
  stage              String   @default("queued")
  originalName       String   @map("original_name")
  storedPath         String   @map("stored_path")
  mimeType           String   @map("mime_type")
  sizeBytes          Int      @map("size_bytes")
  title              String
  source             String
  sourceUrl          String?  @map("source_url")
  cropId             String?  @map("crop_id")
  docType            String   @default("reference") @map("doc_type")
  verificationStatus String   @default("unverified") @map("verification_status")
  extractedChars     Int      @default(0) @map("extracted_chars")
  chunkCount         Int      @default(0) @map("chunk_count")
  processedChunks    Int      @default(0) @map("processed_chunks")
  errorMessage       String?  @map("error_message")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt          DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt         DateTime? @map("finished_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt])
  @@index([status, createdAt])
  @@map("kb_ingestion_jobs")
}

// ---- Role-based onboarding (navid) -----------------------------------------

model TenantRequest {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  orgName   String   @map("org_name")
  district  String
  upazila   String?
  note      String?
  status    String   @default("pending") // pending | approved | rejected
  decidedBy String?  @map("decided_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([status])
  @@map("tenant_requests")
}

model FarmerOnboarding {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  fullName         String?  @map("full_name")
  phone            String?
  district         String
  upazila          String?
  farmSizeDecimals Decimal? @map("farm_size_decimals") @db.Decimal(10, 2)
  soilTexture      String?  @map("soil_texture")
  waterAvailability String? @map("water_availability")
  budgetBdt        Decimal? @map("budget_bdt") @db.Decimal(12, 2)
  targetSeason     String?  @map("target_season")
  filledBy         String   @default("self") @map("filled_by") // self | tenant
  filledByUserId   String?  @map("filled_by_user_id") @db.Uuid
  status           String   @default("submitted") // draft | submitted
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([district])
  @@map("farmer_onboardings")
}

model ProfileAssistRequest {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  fullName           String?  @map("full_name")
  phone              String?
  district           String
  upazila            String?
  note               String?
  status             String   @default("pending") // pending | claimed | fulfilled | cancelled
  claimedByTenantSlug String? @map("claimed_by_tenant_slug")
  claimedByUserId    String?  @map("claimed_by_user_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([district, status])
  @@index([userId])
  @@map("profile_assist_requests")
}
