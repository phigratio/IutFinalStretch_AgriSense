# Copy to /srv/muqtadir/iut_ict_fest/.env on the VPS, or let GitHub Actions
# render it from repository/environment secrets.

NODE_ENV=production
PUBLIC_HOST=your-domain.example

# Host Nginx proxies to these loopback ports. These match the verified free VPS
# ports from the deployment audit.
VPS_APP_BIND=127.0.0.1
VPS_APP_PORT=8093
VPS_FRONTEND_BIND=127.0.0.1
VPS_FRONTEND_PORT=8095
VPS_GRAFANA_BIND=127.0.0.1
VPS_GRAFANA_PORT=8094

# Database
POSTGRES_DB=iut_ict_fest
POSTGRES_USER=iut_ict_fest
POSTGRES_PASSWORD=replace-with-strong-db-password

# Auth
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_TOKEN_TTL_SECONDS=3600
COOKIE_SECURE=true
FRONTEND_AUTH_SUCCESS_URL=https://your-domain.example/
GOOGLE_CALLBACK_URL=https://your-domain.example/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI and mem0
OPENAI_API_KEY=
OPENAI_INTAKE_MODEL=gpt-4.1-mini
MEM0_API_KEY=replace-with-strong-mem0-admin-key
MEM0_AUTH_DISABLED=false
MEM0_JWT_SECRET=replace-with-at-least-32-random-characters
MEM0_NEO4J_PASSWORD=replace-with-strong-neo4j-password
MEM0_DEFAULT_LLM_MODEL=gpt-4o-mini
MEM0_DEFAULT_EMBEDDER_MODEL=text-embedding-3-small
MEM0_EMBEDDER_PROVIDER=openai
MEM0_EMBEDDING_DIMS=1536
RAG_EMBEDDING_DIMENSIONS=1536
MEM0_PERSISTENCE_ENABLED=true

# Temporal
TEMPORAL_TASK_QUEUE=agrisense-cron
TEMPORAL_ENSURE_SCHEDULES=true
TEMPORAL_POSTGRES_PASSWORD=replace-with-strong-temporal-db-password

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-grafana-password

# bdapps. Leave MOCK_BDAPPS empty for real sandbox/production usage.
BDAPPS_APP_ID=
BDAPPS_PASSWORD=
BDAPPS_APP_NAME=AgriSense
BDAPPS_BASE_URL=https://developer.bdapps.com
MOCK_BDAPPS=
MOCK_BDAPPS_BALANCE=100
