apiVersion: 1

datasources:
  - name: Prometheus
    type: prometheus
    access: proxy
    url: ${PROMETHEUS_DS_URL:-http://prometheus:9090}
    isDefault: true
    editable: true
  - name: Loki
    type: loki
    access: proxy
    url: ${LOKI_DS_URL:-http://loki:3100}
    editable: true
    jsonData:
      derivedFields:
        - datasourceUid: tempo
          matcherRegex: '"trace.id":"([a-f0-9]+)"'
          name: TraceID
          url: '$${__value.raw}'
  - name: Tempo
    uid: tempo
    type: tempo
    access: proxy
    url: ${TEMPO_DS_URL:-http://tempo:3200}
    editable: true
    jsonData:
      tracesToLogsV2:
        datasourceUid: Loki
      serviceMap:
        datasourceUid: Prometheus
